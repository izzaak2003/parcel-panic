{
  "name": "parcel-panic",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "ShiftSync": { "$className": "RemoteEvent" },
        "RulebookShown": { "$className": "RemoteEvent" },
        "ParcelScanned": { "$className": "RemoteEvent" },
        "VerdictJudged": { "$className": "RemoteEvent" },
        "DeskSync": { "$className": "RemoteEvent" },
        "SubmitVerdict": { "$className": "RemoteEvent" },
        "RequestShift": { "$className": "RemoteEvent" },
        "RequestSwitch": { "$className": "RemoteEvent" }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
